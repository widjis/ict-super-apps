PORT=8081
CORS_ORIGIN=*
JWT_SECRET=change_me
JWT_EXPIRES_IN=12h
POMON_API_BASE_URL=http://localhost:3001
POMON_API_KEY=
LDAP_URL=ldaps://your-ad:636
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_SEARCH_BASE=
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_ALLOWED_GROUPS=
# WiFi Phase 1: backend-only read-only SSH transport (port 22).
# Empty config leaves lookup unavailable. Provision an approved least-privilege
# service account before rollout; never copy personal diagnosis credentials.
MIKROTIK_HOST=
MIKROTIK_USER=
MIKROTIK_PASSWORD=
# OpenSSH SHA256 fingerprint, independently approved out of band.
MIKROTIK_SSH_FINGERPRINT=
